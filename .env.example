# UnifiedGuard.cloud — BETA — copiez ce fichier en `.env` puis éditez.
# docker compose lit automatiquement `.env` à côté du docker-compose.yml.

# --- PostgreSQL (doit être un fort secret) ---
POSTGRES_USER=unifiedguard
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=unifiedguard

# --- Hub / centrale ---
# FQDN public de la centrale (affiché dans l'UI, utilisé par les agents).
HUB_DOMAIN=central.exemple.fr
# Port HTTP publié sur la machine hôte.
HUB_PORT=8080

# Premier administrateur : créé UNIQUEMENT au tout premier boot
# (table hub_users vide). Changez le mot de passe après le premier login.
HUB_BOOTSTRAP_ADMIN=admin@exemple.fr
HUB_BOOTSTRAP_PASSWORD=CHANGE_ME_TOO

# --- Build Docker (optionnel — tags de version) ---
GIT_COMMIT=beta
BUILD_DATE=beta